{
  "name": "@kadenco/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migration:preflight": "node --experimental-strip-types operator/preflight.mts",
    "staging:qualify": "node node_modules/cf/bin/cf build --mode staging && node node_modules/cf/bin/cf deploy --prebuilt --dry-run --mode staging",
    "deploy": "node operator/deny-deploy.mjs",
    "test": "npm run build && vitest run && node --experimental-strip-types --test spec/edge.node.mts spec/replica.node.mts spec/bootstrap.node.mts spec/recovery.node.mts spec/migration-role.node.mts spec/host-links.node.mts",
    "test:parity": "node operator/parity.mjs",
    "operator:fixture": "node --experimental-strip-types operator/local.mts --fixture",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "build": "wrangler deploy --dry-run --outdir dist && node operator/build-edge.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "22.20.5",
    "cf": "1.0.0-beta.26",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  }
}
