{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": [
    "src/**/*.ts",
    "operator/**/*.mts",
    "spec/**/*.ts",
    "spec/**/*.mts",
    "vitest.config.ts"
  ]
}
